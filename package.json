{
  "name": "cqr",
  "version": "1.0.0",
  "description": "cQR — fast, lightweight, dependency-free QR Code generator/decoder (ISO/IEC 18004, versions 1–40). Sync API for Node and browsers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compact": {
      "types": "./dist/compact.d.ts",
      "default": "./dist/compact.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen:tables": "node tools/extract-tables.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "bench": "node bench/bench.mjs",
    "size": "node tools/report-size.mjs",
    "prepublishOnly": "npm run gen:tables && npm run build"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "encoder",
    "decoder",
    "iso-18004",
    "zero-dependency"
  ],
  "author": "Vrypt",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
